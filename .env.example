# Copy this file to .env for local use. Never commit .env or real credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=life_assistant
MYSQL_IDENTITY_DATABASE=life_assistant_identity
MYSQL_MERCHANT_DATABASE=life_assistant_merchant
MYSQL_ORDER_DATABASE=life_assistant_order
MYSQL_USER=lifeassist
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_PORT=3306

RABBITMQ_USER=lumalife
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
LUMALIFE_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token

SPRING_PROFILES_ACTIVE=prod,remote
LUMALIFE_IDENTITY_REMOTE_ENABLED=true
LUMALIFE_MERCHANT_REMOTE_ENABLED=true
LUMALIFE_ORDER_REMOTE_ENABLED=true
LUMALIFE_ASSISTANT_REMOTE_ENABLED=true
LUMALIFE_IDENTITY_BACKFILL_COMPLETED=true
LUMALIFE_MERCHANT_BACKFILL_COMPLETED=true
LUMALIFE_ORDER_BACKFILL_COMPLETED=true
LUMALIFE_ASSISTANT_BACKFILL_COMPLETED=true
LUMALIFE_COMPATIBILITY_STORE_ENABLED=false
LUMALIFE_EVENTS_PUBLISHER_ENABLED=true
LUMALIFE_EVENTS_BROKER_ENABLED=true
LUMALIFE_EVENTS_SINK_URL=

FRONTEND_PORT=5173
BACKEND_PORT=8080
IDENTITY_SERVICE_PORT=8081
MERCHANT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
ASSISTANT_SERVICE_PORT=8084

AGNES_ENDPOINT=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.0-flash
AGNES_API_KEY=

# Legacy-only override; use together with SPRING_PROFILES_ACTIVE=monolith or migration.
# LUMALIFE_PERSISTENCE=mysql
