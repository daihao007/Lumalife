    state "order:Order\nPAID" as PAID
    state "order:Order\nACCEPTED" as ACCEPTED
    state "order:Order\nDELIVERING" as DELIVERING
    state "order:Order\nCOMPLETED" as COMPLETED
    state "order:Order\nRECEIVED" as RECEIVED
    state "review:Review\n未评价" as Unreviewed
    state "review:Review\n已评价" as Reviewed
